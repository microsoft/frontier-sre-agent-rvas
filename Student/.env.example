# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# These are set once after Challenge 00 and used by all 'make' targets.
# .env is gitignored — never commit real values.

# Resource group where you created your SRE Agent in Challenge 00.
SRE_AGENT_RG=<your-resource-group>

# Name of your SRE Agent resource.
SRE_AGENT_NAME=<your-agent-name>

# Subscription ID — auto-detected from Terraform outputs if not set here.
# Uncomment and set only if you need to override it.
# SRE_AGENT_SUB=<your-subscription-id>

# Optional Berlin MCP auth token. Used by Terraform to secure the Berlin MCP server
# and by the berlin-mcp connector to send the Authorization header. Leave blank to
# disable auth for the lab.
# BERLIN_MCP_AUTH_TOKEN=
