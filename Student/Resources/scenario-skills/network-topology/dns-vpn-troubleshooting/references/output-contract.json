{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dns-vpn-troubleshooting evidence contract",
  "type": "object",
  "required": [
    "scenario_id",
    "scope",
    "assessed_at",
    "assessment_status",
    "coverage",
    "findings",
    "limitations"
  ],
  "properties": {
    "scenario_id": {
      "const": "dns-vpn-troubleshooting"
    },
    "scope": {
      "type": "object",
      "required": [
        "subscription_ids"
      ],
      "properties": {
        "subscription_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resource_groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "assessment_status": {
      "enum": [
        "Complete",
        "Partial",
        "Not assessed"
      ]
    },
    "coverage": {
      "type": "object",
      "required": [
        "expected_checks",
        "assessed_checks",
        "truncated"
      ],
      "properties": {
        "expected_checks": {
          "type": "integer",
          "minimum": 0
        },
        "assessed_checks": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "severity",
          "evidence",
          "scenario_data"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "Observed",
              "Needs attention",
              "Not applicable",
              "Not assessed"
            ]
          },
          "severity": {
            "enum": [
              "Critical",
              "High",
              "Medium",
              "Low",
              "Info"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "collected_at"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "collected_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "scenario_data": {
            "type": "object",
            "required": [
              "client_ip",
              "query_name",
              "response_code",
              "failure_count",
              "connection_id",
              "connection_status",
              "bgp_peer_state",
              "disconnect_reason",
              "last_successful_connection_utc",
              "correlation_evidence",
              "recommended_checks"
            ],
            "properties": {
              "client_ip": {},
              "query_name": {},
              "response_code": {},
              "failure_count": {},
              "connection_id": {},
              "connection_status": {},
              "bgp_peer_state": {},
              "disconnect_reason": {},
              "last_successful_connection_utc": {},
              "correlation_evidence": {},
              "recommended_checks": {}
            }
          },
          "recommendation": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
