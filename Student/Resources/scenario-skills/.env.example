# Set these in the approved host environment; this file is not loaded automatically.
# Production user assigned managed identity, supplied by the operator:
AZURE_CLIENT_ID=

# Explicit alternatives, never fallback after an authentication error:
# SRE_IDENTITY_MODE=system-assigned
# SRE_IDENTITY_MODE=developer

# Optional verified lifecycle snapshot; absent evidence yields Unknown:
# SRE_LIFECYCLE_EVIDENCE=C:\approved\lifecycle-evidence.json

# Output directory for the shared HTML renderer:
# SRE_REPORT_OUTPUT_DIR=C:\approved\reports
