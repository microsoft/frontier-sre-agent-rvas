{
  "name": "customer-assessment",
  "allowed_tools": ["RunAzCliReadCommands", "RunInTerminal", "SaveFileToBlob"],
  "default_action": "deny",
  "approved_subscription_ids": [],
  "max_calls_per_request": 100,
  "max_pages_per_collection": 100,
  "human_approval_required": ["write", "delete", "role_assignment", "deploy", "send", "schedule", "upload"],
  "terminal_scope": "Validated read commands and local artifact generation only; host authorization must enforce this policy.",
  "http": {
    "allowed_hosts": ["management.azure.com", "graph.microsoft.com", "api.loganalytics.azure.com", "api.loganalytics.io", "prices.azure.com"],
    "allowed_host_suffixes": [".vault.azure.net"],
    "max_attempts": 3,
    "max_delay_seconds": 60
  },
  "audit": {
    "format": "jsonl",
    "append_only": true,
    "fields": ["timestamp", "agent_id", "tool_name", "decision", "policy_name"],
    "exclude": ["prompts", "credentials", "raw_user_content"]
  },
  "sharing": {
    "documentation_hosts": ["learn.microsoft.com"],
    "identifier_keys": ["resource", "resource_id", "resource_name", "subscription", "subscription_id", "subscription_name", "subscriptionId", "resource_group", "resource_group_name", "resourceGroup", "principal", "principal_id", "object_id", "client_id", "caller", "owner", "email", "item", "hostname", "ip_address", "account_name", "accountName", "generated_for"],
    "secret_keys": ["password", "secret", "secret_value", "token", "access_token", "refresh_token", "client_secret", "connection_string", "sas_token", "authorization", "api_key", "accountkey"],
    "secret_patterns": [
      "(?i)(?:Bearer\\s+)[A-Za-z0-9._~+/=-]+",
      "(?i)(?:AccountKey|SharedAccessSignature|ClientSecret|client_secret|api_key|password|sig)\\s*[=:]\\s*[^\\s;&\"'<>]+",
      "eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+"
    ],
    "identifier_patterns": [
      "[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}",
      "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "(?<![0-9.])(?:[0-9]{1,3}\\.){3}[0-9]{1,3}(?![0-9.])",
      "(?i)(?:[a-z0-9-]+\\.)+(?:internal|local|privatelink\\.[a-z0-9.]+)"
    ]
  }
}
