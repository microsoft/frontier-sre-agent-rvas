{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "move-resources-between-subscriptions evidence contract",
  "type": "object",
  "required": [
    "scenario_id",
    "scope",
    "assessed_at",
    "assessment_status",
    "coverage",
    "findings",
    "limitations"
  ],
  "properties": {
    "scenario_id": {
      "const": "move-resources-between-subscriptions"
    },
    "scope": {
      "type": "object",
      "required": [
        "subscription_ids"
      ],
      "properties": {
        "subscription_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resource_groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "assessment_status": {
      "enum": [
        "Complete",
        "Partial",
        "Not assessed"
      ]
    },
    "coverage": {
      "type": "object",
      "required": [
        "expected_checks",
        "assessed_checks",
        "truncated"
      ],
      "properties": {
        "expected_checks": {
          "type": "integer",
          "minimum": 0
        },
        "assessed_checks": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "severity",
          "evidence",
          "scenario_data"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "Observed",
              "Needs attention",
              "Not applicable",
              "Not assessed"
            ]
          },
          "severity": {
            "enum": [
              "Critical",
              "High",
              "Medium",
              "Low",
              "Info"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "collected_at"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "collected_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "scenario_data": {
            "type": "object",
            "required": [
              "source_scope",
              "target_scope",
              "selected_resource_ids",
              "type_support",
              "dependency_blockers",
              "lock_blockers",
              "quota_checks",
              "rbac_impacts",
              "policy_impacts",
              "validation_plan",
              "validation_result",
              "draft_artifact"
            ],
            "properties": {
              "source_scope": {},
              "target_scope": {},
              "selected_resource_ids": {},
              "type_support": {},
              "dependency_blockers": {},
              "lock_blockers": {},
              "quota_checks": {},
              "rbac_impacts": {},
              "policy_impacts": {},
              "validation_plan": {},
              "validation_result": {},
              "draft_artifact": {}
            }
          },
          "recommendation": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
