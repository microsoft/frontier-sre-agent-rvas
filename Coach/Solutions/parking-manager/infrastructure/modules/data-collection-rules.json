      "type": "string",
      "value": "[if(parameters('deployMadridVm'), resourceId('Microsoft.Insights/dataCollectionRules', 'dcr-madrid-windows-events'), '')]"
    },
    "parisSyslogDcrId": {
      "type": "string",
      "value": "[if(parameters('deployParisVm'), resourceId('Microsoft.Insights/dataCollectionRules', 'dcr-paris-syslog'), '')]"
