    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "metadata": {
        "description": "Azure region for monitoring resources"
      }
    },
    "logAnalyticsWorkspaceId": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace resource ID"
      }
    },
    "deployMadridVm": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy Madrid VM data collection association"
      }
    },
    "deployParisVm": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy Paris VM data collection association"
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Tags to apply to monitoring resources"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Insights/dataCollectionEndpoints",
      "apiVersion": "2022-06-01",
      "name": "dce-parking-vm-logs",
      "location": "[parameters('location')]",
      "kind": "Linux",
      "tags": "[parameters('tags')]",
      "properties": {
        "networkAcls": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "condition": "[parameters('deployMadridVm')]",
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2022-06-01",
      "name": "dcr-madrid-windows-events",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "dataCollectionEndpointId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', 'dce-parking-vm-logs')]",
        "streamDeclarations": {},
        "dataSources": {
          "windowsEventLogs": [
            {
              "name": "madrid-windows-events",
              "streams": [
                "Microsoft-Event"
              ],
              "xPathQueries": [
                "Application!*[System[*]]",
                "System!*[System[(Level=1 or Level=2 or Level=3)]]",
                "Security!*[System[(Level=1 or Level=2 or Level=3)]]"
              ]
            }
          ]
        },
        "destinations": {
          "logAnalytics": [
            {
              "name": "la-madrid-windows-events",
              "workspaceResourceId": "[parameters('logAnalyticsWorkspaceId')]"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "Microsoft-Event"
            ],
            "destinations": [
              "la-madrid-windows-events"
            ]
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/dataCollectionEndpoints', 'dce-parking-vm-logs')]"
      ]
    },
    {
      "condition": "[parameters('deployParisVm')]",
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2022-06-01",
      "name": "dcr-paris-syslog",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "dataCollectionEndpointId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', 'dce-parking-vm-logs')]",
        "streamDeclarations": {},
        "dataSources": {
          "syslog": [
            {
              "name": "paris-linux-syslog",
              "streams": [
                "Microsoft-Syslog"
              ],
              "facilityNames": [
                "auth",
                "authpriv",
                "cron",
                "daemon",
                "kern",
                "local0",
                "local1",
                "local2",
                "local3",
                "local4",
                "local5",
                "local6",
                "local7",
                "syslog",
                "user"
              ],
              "logLevels": [
                "Emergency",
                "Alert",
                "Critical",
                "Error",
                "Warning",
                "Notice",
                "Informational",
                "Debug"
              ]
            }
          ]
        },
        "destinations": {
          "logAnalytics": [
            {
              "name": "la-paris-syslog",
              "workspaceResourceId": "[parameters('logAnalyticsWorkspaceId')]"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "Microsoft-Syslog"
            ],
            "destinations": [
              "la-paris-syslog"
            ]
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/dataCollectionEndpoints', 'dce-parking-vm-logs')]"
      ]
    }
  ],
  "outputs": {
    "dataCollectionEndpointId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', 'dce-parking-vm-logs')]"
    },
    "dataCollectionEndpointLogsUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', 'dce-parking-vm-logs'), '2022-06-01').logsIngestion.endpoint]"
    },
