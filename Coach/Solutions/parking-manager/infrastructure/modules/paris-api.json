{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "725796804346344046"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "metadata": {
        "description": "Location for all Paris API resources"
      }
    },
    "vmSubnetId": {
      "type": "string",
      "metadata": {
        "description": "VM subnet ID from hub VNet"
      }
    },
    "adminUsername": {
      "type": "string",
      "metadata": {
        "description": "Admin username for the VM"
      }
    },
    "adminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Admin password for the VM"
      }
    },
    "createPublicIp": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Create public IP for the VM"
      }
    },
    "deployVM": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy VM resources (set to false if VM already exists to avoid disk update conflicts)"
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Tags to apply to resources"
      }
    }
  },
  "variables": {
    "parisApiDirectory": "/opt/paris-parking-api",
    "parisCloudInitTemplate": "#cloud-config\npackage_update: true\npackages:\n  - ca-certificates\n  - curl\n  - gnupg\n  - rsyslog\n  - ufw\n  - openssl\n\nwrite_files:\n  - path: /usr/local/bin/bootstrap-paris-api.sh\n    permissions: '0755'\n    content: |\n      #!/usr/bin/env bash\n      set -euo pipefail\n\n      API_DIR=\"__PARIS_API_DIRECTORY__\"\n      SERVICE_NAME=\"paris-parking-api\"\n\n      mkdir -p /etc/apt/keyrings\n      curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor --batch --yes -o /etc/apt/keyrings/nodesource.gpg\n      echo \"deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_18.x nodistro main\" > /etc/apt/sources.list.d/nodesource.list\n\n      apt-get update\n      apt-get install -y nodejs\n\n      mkdir -p \"$API_DIR\" /opt/shared\n\n      if [[ ! -f \"$API_DIR/paris.key\" || ! -f \"$API_DIR/paris.crt\" ]]; then\n        openssl req -new -x509 \\\n          -keyout \"$API_DIR/paris.key\" \\\n          -out \"$API_DIR/paris.crt\" \\\n          -days 365 \\\n          -nodes \\\n          -subj \"/C=FR/ST=Paris/L=Paris/O=Parking/OU=API/CN=paris-api\"\n      fi\n\n      cat > \"$API_DIR/.env\" <<EOF\n      PORT=3003\n      NODE_ENV=production\n      CERT_PATH=$API_DIR/paris.crt\n      KEY_PATH=$API_DIR/paris.key\n      PARKING_NAME=Paris Centre Parking\n      PARKING_CITY=Paris\n      PARKING_LOCATION=Champs-Elysees, Paris\n      SYSLOG_FACILITY=local0\n      SYSLOG_TAG=ParisParkingAPI\n      EOF\n\n      chmod 600 \"$API_DIR/paris.key\"\n      chmod 644 \"$API_DIR/paris.crt\"\n      chown -R __ADMIN_USERNAME__:__ADMIN_USERNAME__ \"$API_DIR\" /opt/shared\n\n      cat > /etc/systemd/system/${'$'}{SERVICE_NAME}.service <<EOF\n      [Unit]\n      Description=Paris Parking API Service\n      After=network.target\n      ConditionPathExists=$API_DIR/server.js\n\n      [Service]\n      Type=simple\n        User=__ADMIN_USERNAME__\n      WorkingDirectory=$API_DIR\n      ExecStart=/usr/bin/node server.js\n      Restart=on-failure\n      RestartSec=10\n      StandardOutput=journal\n      StandardError=journal\n      SyslogIdentifier=paris-parking-api\n      EnvironmentFile=$API_DIR/.env\n\n      [Install]\n      WantedBy=multi-user.target\n      EOF\n\n      systemctl daemon-reload\n      systemctl enable \"$SERVICE_NAME\"\n      ufw allow 3003/tcp || true\n\n  - path: /etc/motd.d/parking-manager\n    permissions: '0644'\n    content: |\n      Paris Parking API bootstrap is handled by cloud-init.\n      Deploy application code with workflows/deploy-vm-apps.yml.\n\nruncmd:\n  - /usr/local/bin/bootstrap-paris-api.sh\n",
    "parisCloudInit": "[replace(replace(variables('parisCloudInitTemplate'), '__PARIS_API_DIRECTORY__', variables('parisApiDirectory')), '__ADMIN_USERNAME__', parameters('adminUsername'))]"
  },
  "resources": [
    {
      "condition": "[parameters('createPublicIp')]",
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-05-01",
      "name": "pip-paris-vm",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "dnsSettings": {
          "domainNameLabel": "[format('paris-parking-{0}', uniqueString(resourceGroup().id))]"
        }
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-05-01",
      "name": "nic-paris-vm",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "subnet": {
                "id": "[parameters('vmSubnetId')]"
              },
              "privateIPAllocationMethod": "Dynamic",
              "publicIPAddress": "[if(parameters('createPublicIp'), createObject('id', resourceId('Microsoft.Network/publicIPAddresses', 'pip-paris-vm')), null())]"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', 'pip-paris-vm')]"
      ]
    },
    {
      "condition": "[parameters('deployVM')]",
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2023-03-01",
      "name": "vm-paris-api",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "hardwareProfile": {
          "vmSize": "Standard_B2s"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "0001-com-ubuntu-server-jammy",
            "sku": "22_04-lts-gen2",
            "version": "latest"
          },
          "osDisk": {
            "name": "osdisk-paris-vm",
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "StandardSSD_LRS"
            },
            "diskSizeGB": 30
          }
        },
        "osProfile": {
          "computerName": "paris-api",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          "customData": "[base64(variables('parisCloudInit'))]",
          "linuxConfiguration": {
            "disablePasswordAuthentication": false,
            "provisionVMAgent": true,
            "patchSettings": {
              "patchMode": "AutomaticByPlatform"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', 'nic-paris-vm')]"
            }
          ]
        },
        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', 'nic-paris-vm')]"
      ]
    },
    {
      "condition": "[parameters('deployVM')]",
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2023-03-01",
      "name": "[format('{0}/{1}', 'vm-paris-api', 'AzureMonitorLinuxAgent')]",
      "location": "[parameters('location')]",
      "properties": {
        "publisher": "Microsoft.Azure.Monitor",
        "type": "AzureMonitorLinuxAgent",
        "typeHandlerVersion": "1.0",
        "autoUpgradeMinorVersion": true,
        "enableAutomaticUpgrade": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', 'vm-paris-api')]"
      ]
    }
  ],
  "outputs": {
    "vmName": {
      "type": "string",
      "value": "[if(parameters('deployVM'), 'vm-paris-api', '')]"
    },
    "vmId": {
      "type": "string",
      "value": "[if(parameters('deployVM'), resourceId('Microsoft.Compute/virtualMachines', 'vm-paris-api'), '')]"
    },
    "vmPrincipalId": {
      "type": "string",
      "value": "[if(parameters('deployVM'), reference(resourceId('Microsoft.Compute/virtualMachines', 'vm-paris-api'), '2023-03-01', 'full').identity.principalId, '')]"
    },
    "privateIpAddress": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/networkInterfaces', 'nic-paris-vm'), '2023-05-01').ipConfigurations[0].properties.privateIPAddress]"
    },
    "publicIpAddress": {
      "type": "string",
      "value": "[if(and(parameters('deployVM'), parameters('createPublicIp')), reference(resourceId('Microsoft.Network/publicIPAddresses', 'pip-paris-vm'), '2023-05-01').ipAddress, '')]"
    },
    "fqdn": {
      "type": "string",
      "value": "[if(and(parameters('deployVM'), parameters('createPublicIp')), reference(resourceId('Microsoft.Network/publicIPAddresses', 'pip-paris-vm'), '2023-05-01').dnsSettings.fqdn, '')]"
    },
    "apiUrl": {
      "type": "string",
      "value": "[if(and(parameters('deployVM'), parameters('createPublicIp')), format('http://{0}:3003', reference(resourceId('Microsoft.Network/publicIPAddresses', 'pip-paris-vm'), '2023-05-01').dnsSettings.fqdn), format('http://{0}:3003', reference(resourceId('Microsoft.Network/networkInterfaces', 'nic-paris-vm'), '2023-05-01').ipConfigurations[0].properties.privateIPAddress))]"
    }
  }
}