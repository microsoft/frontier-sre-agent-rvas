{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "13848402059689360235"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "metadata": {
        "description": "Location for all Madrid API resources"
      }
    },
    "vmSubnetId": {
      "type": "string",
      "metadata": {
        "description": "VM subnet ID from hub VNet"
      }
    },
    "adminUsername": {
      "type": "string",
      "metadata": {
        "description": "Admin username for the VM"
      }
    },
    "adminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Admin password for the VM"
      }
    },
    "createPublicIp": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Create public IP for the VM"
      }
    },
    "deployVM": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy VM resources (set to false if VM already exists to avoid disk update conflicts)"
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Tags to apply to resources"
      }
    }
  },
  "variables": {
    "madridBootstrapScript": "$ErrorActionPreference = 'Stop'\n\n$appDir = 'C:\\Apps\\madrid-parking-api'\n$sharedDir = 'C:\\Apps\\shared'\n$envFile = Join-Path $appDir '.env'\n$pfxPath = Join-Path $appDir 'madrid.pfx'\n$runnerPath = Join-Path $appDir 'run-madrid-api.ps1'\n$serviceName = 'MadridParkingAPI'\n$serviceDisplayName = 'Madrid Parking API'\n$nodeVersion = '18.20.4'\n$nodeMsi = \"node-v$nodeVersion-x64.msi\"\n$nodeUrl = \"https://nodejs.org/dist/v$nodeVersion/$nodeMsi\"\n$nodeInstaller = Join-Path $env:TEMP $nodeMsi\n$pfxPassphrase = 'ChangeMe123!'\n$nodeExe = 'C:\\Program Files\\nodejs\\node.exe'\n\nNew-Item -ItemType Directory -Force -Path $appDir | Out-Null\nNew-Item -ItemType Directory -Force -Path $sharedDir | Out-Null\n\nif (-not (Test-Path $nodeExe)) {\n  Invoke-WebRequest -Uri $nodeUrl -OutFile $nodeInstaller -UseBasicParsing\n  Start-Process msiexec.exe -ArgumentList \"/i `\"$nodeInstaller`\" /qn /norestart\" -Wait\n}\n\nif (-not (Test-Path $pfxPath)) {\n  $cert = New-SelfSignedCertificate -DnsName 'madrid-api' -CertStoreLocation 'cert:\\LocalMachine\\My' -FriendlyName 'Madrid Parking API'\n  $securePassphrase = ConvertTo-SecureString $pfxPassphrase -AsPlainText -Force\n  Export-PfxCertificate -Cert \"cert:\\LocalMachine\\My\\$($cert.Thumbprint)\" -FilePath $pfxPath -Password $securePassphrase | Out-Null\n}\n\n@\"\nEVENT_LOG_SOURCE=MadridParkingAPI\nEVENT_LOG_NAME=Application\nPORT=3002\nNODE_ENV=production\nPFX_PATH=$pfxPath\nPFX_PASSPHRASE=$pfxPassphrase\nPARKING_NAME=Madrid Centro Parking\nPARKING_CITY=Madrid\nPARKING_LOCATION=Plaza Mayor, Madrid\n\"@ | Set-Content -Path $envFile -Encoding UTF8\n\n@\"\n$appDir = 'C:\\Apps\\madrid-parking-api'\n$nodeExe = 'C:\\Program Files\\nodejs\\node.exe'\n\nif (-not (Test-Path (Join-Path $appDir 'server.js'))) {\n  Start-Sleep -Seconds 10\n  exit 1\n}\n\nSet-Location $appDir\n& $nodeExe server.js\n\"@ | Set-Content -Path $runnerPath -Encoding UTF8\n\nif (-not (Get-Service -Name $serviceName -ErrorAction SilentlyContinue)) {\n  $binPath = \"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -File `\"$runnerPath`\"\"\n  sc.exe create $serviceName binPath= $binPath start= auto DisplayName= $serviceDisplayName | Out-Null\n  sc.exe failure $serviceName reset= 60 actions= restart/5000 | Out-Null\n}\n\nNew-NetFirewallRule -DisplayName 'Madrid Parking API 3002' -Direction Inbound -LocalPort 3002 -Protocol TCP -Action Allow -ErrorAction SilentlyContinue | Out-Null\n",
    "madridBootstrapCommandTemplate": "powershell -ExecutionPolicy Bypass -Command \"[System.IO.File]::WriteAllText('C:\\Windows\\Temp\\bootstrap-madrid.ps1', [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String('__BOOTSTRAP_BASE64__'))); & 'C:\\Windows\\Temp\\bootstrap-madrid.ps1'\"",
    "madridBootstrapCommand": "[replace(variables('madridBootstrapCommandTemplate'), '__BOOTSTRAP_BASE64__', base64(variables('madridBootstrapScript')))]"
  },
  "resources": [
    {
      "condition": "[parameters('createPublicIp')]",
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-05-01",
      "name": "pip-madrid-vm",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "dnsSettings": {
          "domainNameLabel": "[format('madrid-parking-{0}', uniqueString(resourceGroup().id))]"
        }
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-05-01",
      "name": "nic-madrid-vm",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "subnet": {
                "id": "[parameters('vmSubnetId')]"
              },
              "privateIPAllocationMethod": "Dynamic",
              "publicIPAddress": "[if(parameters('createPublicIp'), createObject('id', resourceId('Microsoft.Network/publicIPAddresses', 'pip-madrid-vm')), null())]"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', 'pip-madrid-vm')]"
      ]
    },
    {
      "condition": "[parameters('deployVM')]",
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2023-03-01",
      "name": "vm-madrid-api",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "hardwareProfile": {
          "vmSize": "Standard_B2s"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "MicrosoftWindowsServer",
            "offer": "WindowsServer",
            "sku": "2022-datacenter-azure-edition-smalldisk",
            "version": "latest"
          },
          "osDisk": {
            "name": "osdisk-madrid-vm",
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "StandardSSD_LRS"
            },
            "diskSizeGB": 64
          }
        },
        "osProfile": {
          "computerName": "madrid-api",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          "windowsConfiguration": {
            "enableAutomaticUpdates": true,
            "provisionVMAgent": true,
            "patchSettings": {
              "patchMode": "AutomaticByOS"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', 'nic-madrid-vm')]"
            }
          ]
        },
        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', 'nic-madrid-vm')]"
      ]
    },
    {
      "condition": "[parameters('deployVM')]",
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2023-03-01",
      "name": "[format('{0}/{1}', 'vm-madrid-api', 'AzureMonitorWindowsAgent')]",
      "location": "[parameters('location')]",
      "properties": {
        "publisher": "Microsoft.Azure.Monitor",
        "type": "AzureMonitorWindowsAgent",
        "typeHandlerVersion": "1.0",
        "autoUpgradeMinorVersion": true,
        "enableAutomaticUpgrade": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', 'vm-madrid-api')]"
      ]
    },
    {
      "condition": "[parameters('deployVM')]",
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2023-03-01",
      "name": "[format('{0}/{1}', 'vm-madrid-api', 'CustomScriptExtension')]",
      "location": "[parameters('location')]",
      "properties": {
        "publisher": "Microsoft.Compute",
        "type": "CustomScriptExtension",
        "typeHandlerVersion": "1.10",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "commandToExecute": "[variables('madridBootstrapCommand')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines/extensions', 'vm-madrid-api', 'AzureMonitorWindowsAgent')]",
        "[resourceId('Microsoft.Compute/virtualMachines', 'vm-madrid-api')]"
      ]
    }
  ],
  "outputs": {
    "vmName": {
      "type": "string",
      "value": "[if(parameters('deployVM'), 'vm-madrid-api', '')]"
    },
    "vmId": {
      "type": "string",
      "value": "[if(parameters('deployVM'), resourceId('Microsoft.Compute/virtualMachines', 'vm-madrid-api'), '')]"
    },
    "vmPrincipalId": {
      "type": "string",
      "value": "[if(parameters('deployVM'), reference(resourceId('Microsoft.Compute/virtualMachines', 'vm-madrid-api'), '2023-03-01', 'full').identity.principalId, '')]"
    },
    "privateIpAddress": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/networkInterfaces', 'nic-madrid-vm'), '2023-05-01').ipConfigurations[0].properties.privateIPAddress]"
    },
    "publicIpAddress": {
      "type": "string",
      "value": "[if(and(parameters('deployVM'), parameters('createPublicIp')), reference(resourceId('Microsoft.Network/publicIPAddresses', 'pip-madrid-vm'), '2023-05-01').ipAddress, '')]"
    },
    "fqdn": {
      "type": "string",
      "value": "[if(and(parameters('deployVM'), parameters('createPublicIp')), reference(resourceId('Microsoft.Network/publicIPAddresses', 'pip-madrid-vm'), '2023-05-01').dnsSettings.fqdn, '')]"
    },
    "apiUrl": {
      "type": "string",
      "value": "[if(and(parameters('deployVM'), parameters('createPublicIp')), format('http://{0}:3002', reference(resourceId('Microsoft.Network/publicIPAddresses', 'pip-madrid-vm'), '2023-05-01').dnsSettings.fqdn), format('http://{0}:3002', reference(resourceId('Microsoft.Network/networkInterfaces', 'nic-madrid-vm'), '2023-05-01').ipConfigurations[0].properties.privateIPAddress))]"
    }
  }
}