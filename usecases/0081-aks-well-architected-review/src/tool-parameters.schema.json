{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "generate-aks-waf-report parameters",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation": {
      "type": "string",
      "enum": [
        "report",
        "query",
        "list_clusters"
      ],
      "default": "report",
      "description": "report writes one report (HTML + JSON + 2 CSV) for the selection; no selection = every visible cluster (at most 100). query filters a fresh collection of 1 cluster (or up to 5 in cluster_names). list_clusters returns one page (limit/offset) of the inventory discovered with Azure Resource Graph across every readable subscription (optionally filtered by subscription); inventory, not observed health."
    },
    "view": {
      "type": "string",
      "enum": [
        "summary",
        "cluster",
        "node_pools",
        "workloads",
        "resources",
        "findings",
        "finops",
        "coverage",
        "actions",
        "architecture"
      ],
      "default": "summary",
      "description": "findings exposes all checks; report findings contains failed checks only. coverage exposes scoped source receipts. architecture exposes observed nodes/edges and explicit unknowns."
    },
    "cluster_name": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[A-Za-z0-9_.()-]*$",
      "default": "",
      "description": "One cluster by exact name (case-insensitive) as returned by list_clusters. If the same AKS name exists in several subscriptions, add subscription or use the prefixed list_clusters name. Mutually exclusive with cluster_names."
    },
    "cluster_names": {
      "type": "string",
      "maxLength": 6400,
      "pattern": "^(?:all|ALL|All|[A-Za-z0-9_.()-]{1,63}(?:,[A-Za-z0-9_.()-]{1,63}){0,99})?$",
      "default": "",
      "description": "\"all\" = every visible cluster (after the subscription filter), or 1 to 100 exact comma-separated names without spaces. Empty in report means \"all\". A failed cluster is reported as an error, never as healthy."
    },
    "subscription": {
      "type": "string",
      "maxLength": 128,
      "default": "",
      "description": "Optional subscription filter: subscription ID (GUID) or exact display name (case-insensitive). Compared locally with the discovered inventory, never sent to Azure. Valid for report, query and list_clusters."
    },
    "namespace": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[A-Za-z0-9_.()-]*$",
      "default": "",
      "description": "Exact local namespace filter, never a server-side scope override."
    },
    "workload_name": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9_.()-]*$",
      "default": "",
      "description": "Exact local workload-name filter; no URL/path/query/command."
    },
    "area": {
      "type": "string",
      "enum": [
        "all",
        "best_practices",
        "security",
        "finops",
        "optimization"
      ],
      "default": "all"
    },
    "level": {
      "type": "string",
      "enum": [
        "all",
        "cluster",
        "workload",
        "resource"
      ],
      "default": "all"
    },
    "severity": {
      "type": "string",
      "enum": [
        "all",
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "all"
    },
    "status": {
      "type": "string",
      "enum": [
        "all",
        "passed",
        "failed",
        "not_evaluated",
        "not_applicable",
        "complete",
        "partial",
        "denied",
        "error",
        "not_configured"
      ],
      "default": "all"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 25,
      "description": "Rows requested for query/list_clusters; the 3500-byte budget may return fewer whole rows (use next_offset)."
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500000,
      "default": 0,
      "description": "Local offset in this fresh collection; not a persistent cursor."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "report"
          }
        }
      },
      "then": {
        "properties": {
          "view": {
            "const": "summary"
          },
          "namespace": {
            "const": ""
          },
          "workload_name": {
            "const": ""
          },
          "area": {
            "const": "all"
          },
          "level": {
            "const": "all"
          },
          "severity": {
            "const": "all"
          },
          "status": {
            "const": "all"
          },
          "limit": {
            "const": 25
          },
          "offset": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "list_clusters"
          }
        }
      },
      "then": {
        "properties": {
          "view": {
            "const": "summary"
          },
          "namespace": {
            "const": ""
          },
          "workload_name": {
            "const": ""
          },
          "area": {
            "const": "all"
          },
          "level": {
            "const": "all"
          },
          "severity": {
            "const": "all"
          },
          "status": {
            "const": "all"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cluster_name": {
            "minLength": 1
          }
        },
        "required": [
          "cluster_name"
        ]
      },
      "then": {
        "properties": {
          "cluster_names": {
            "const": ""
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cluster_names": {
            "minLength": 1
          }
        },
        "required": [
          "cluster_names"
        ]
      },
      "then": {
        "properties": {
          "cluster_name": {
            "const": ""
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "list_clusters"
          }
        }
      },
      "then": {
        "properties": {
          "cluster_name": {
            "const": ""
          },
          "cluster_names": {
            "const": ""
          }
        }
      }
    }
  ]
}
